# =====================================================================
# VitaLens - Environment Configuration Template
# Copy this file to .env and fill in your local or production settings:
#   cp .env.example .env
# =====================================================================

# App Environment (development / production / testing)
ENVIRONMENT=development
PROJECT_NAME="VitaLens AI Health Report & Doctor Recommendation API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration:
# - Local SQLite (Default, no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./health_app.db
# - PostgreSQL (Production / Staging):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/vitalens_db

# Security & JWT Tokens
# NOTE: In production, generate a secure random 64-char key (e.g. `openssl rand -hex 32`)
SECRET_KEY=dev_secret_key_change_in_production_vitalens_2026_jwt_token_key_9921
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000","http://localhost:5173","http://127.0.0.1:8081"]

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# Storage Provider: "local" (default), "imagekit", or "gcs" (Firebase Blaze)
STORAGE_PROVIDER=local

# ImageKit Configuration (Required if STORAGE_PROVIDER=imagekit)
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Google Cloud Storage / Firebase (Required if STORAGE_PROVIDER=gcs)
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# MongoDB Atlas Integration (Optional: for cloud unstructured storage)
MONGODB_URL=
MONGODB_DB_NAME=vitalens_db

# Payment Gateway (Razorpay - Optional)
ENABLE_PAYMENTS=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
